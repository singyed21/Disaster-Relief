{
  "name": "disaster-relief-portal",
  "version": "3.0.0",
  "description": "Disaster relief portal: money, medical-support and rescue-team donations with full donation tracing, admin control, email verification and payments",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "db:init": "node scripts/initDb.js",
    "db:seed": "node scripts/initDb.js --seed",
    "admin:create": "node scripts/createAdmin.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "dotenv": "^18.0.4",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.0.0",
    "express-session": "^1.18.1",
    "multer": "^2.4.0",
    "nodemailer": "^7.0.0",
    "pg-promise": "^12.7.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
