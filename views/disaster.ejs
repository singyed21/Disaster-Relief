<%- include('partials/header') %>

<p class="crumbs"><a href="/disasters">Disasters</a> / <%= d.title %></p>
<div class="detail-grid">
  <div>
    <div class="tags">
      <span class="tag sev-<%= d.severity %>"><%= d.severity %> severity</span>
      <span class="tag"><%= d.disaster_type %></span>
      <span class="tag"><%= d.status %></span>
    </div>
    <h1><%= d.title %></h1>
    <p class="muted"><%= d.location %> · started <%= fmtDate(d.started_on) %></p>
    <% if (d.image_url) { %>
      <figure class="hero-fig"><img class="hero-img" src="<%= d.image_url %>" alt="Photo: <%= d.title %>">
      <% if (d.image_credit) { %><figcaption class="small muted">Photo: <%= d.image_credit %></figcaption><% } %></figure>
    <% } %>
    <p class="prewrap"><%= d.description %></p>

    <% if (d.needs_medical || d.needs_rescue) { %>
      <h2>What is needed</h2>
      <div class="grid two">
        <% if (d.needs_medical) { %><div class="card pad"><h3>Medical support</h3><p class="prewrap"><%= d.needs_medical %></p></div><% } %>
        <% if (d.needs_rescue) { %><div class="card pad"><h3>Rescue teams</h3><p class="prewrap"><%= d.needs_rescue %></p></div><% } %>
      </div>
    <% } %>

    <h2>Situation updates</h2>
    <% if (!updates.length) { %><p class="muted">No updates yet.</p><% } %>
    <% updates.forEach(function (u) { %>
      <div class="update"><strong><%= u.title %></strong> <span class="muted small"><%= fmtDate(u.created_at) %></span><p class="prewrap"><%= u.body %></p></div>
    <% }) %>

    <h2>How funds were used</h2>
    <% if (!allocations.length) { %><p class="muted">No spending has been recorded yet.</p><% } else { %>
      <table class="table">
        <thead><tr><th>Date</th><th>What</th><th class="num">Amount</th></tr></thead>
        <tbody>
        <% allocations.forEach(function (a) { %>
          <tr><td><%= fmtDate(a.spent_on) %></td><td><strong><%= a.title %></strong><% if (a.description) { %><br><span class="muted small"><%= a.description %></span><% } %></td><td class="num"><%= fmtMoney(a.amount) %></td></tr>
        <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>

  <aside>
    <div class="card pad sticky">
      <h3>Support this campaign</h3>
      <p class="big"><%= fmtMoney(d.raised) %></p>
      <p class="muted small">raised (confirmed)</p>
      <p class="small muted"><%= fmtMoney(d.allocated) %> spent so far · <%= d.donor_count %> donations · <%= d.medical_count %> medical pledges · <%= d.rescue_count %> rescue offers</p>
      <% if (d.status === 'active') { %>
        <a class="btn block" href="/donate?disaster=<%= d.id %>&type=money">Donate money</a>
        <a class="btn btn-outline block" href="/donate?disaster=<%= d.id %>&type=medical">Pledge medical support</a>
        <a class="btn btn-outline block" href="/donate?disaster=<%= d.id %>&type=rescue">Offer a rescue team</a>
      <% } else { %>
        <p class="alert alert-info">This campaign is closed and no longer accepts donations.</p>
      <% } %>
      <% if (recent.length) { %>
        <h4>Recent supporters</h4>
        <ul class="plain">
          <% recent.forEach(function (r) { %>
            <li><%= r.donor %> · <%= r.donation_type === 'money' ? fmtMoney(r.amount, r.currency) : typeLabel(r.donation_type) %></li>
          <% }) %>
        </ul>
      <% } %>
    </div>
  </aside>
</div>

<%- include('partials/footer') %>