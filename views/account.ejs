<%- include('partials/header') %>

<h1>My account</h1>
<p class="muted"><%= user.name %> · <%= user.email %></p>

<section class="stats">
  <div class="stat"><strong><%= fmtMoney(total) %></strong><span>given (confirmed payments)</span></div>
  <div class="stat"><strong><%= donations.length %></strong><span>total donations and pledges</span></div>
</section>

<h2>My donations</h2>
<% if (!donations.length) { %>
  <p class="muted">You have not donated yet. <a href="/donate">Make your first donation</a>.</p>
<% } else { %>
<div class="table-wrap">
<table class="table">
  <thead><tr><th>Date</th><th>Disaster</th><th>Type</th><th class="num">Amount</th><th>Status</th><th></th></tr></thead>
  <tbody>
  <% donations.forEach(function (d) { %>
    <tr>
      <td><%= fmtDate(d.created_at) %></td>
      <td><%= d.disaster_title %></td>
      <td><%= typeLabel(d.donation_type) %></td>
      <td class="num"><%= d.donation_type === 'money' ? fmtMoney(d.amount, d.currency) : '-' %></td>
      <td><span class="badge st-<%= d.status %>"><%= statusLabel(d.donation_type, d.status) %></span></td>
      <td><a href="/donations/<%= d.reference %>">Trace</a></td>
    </tr>
  <% }) %>
  </tbody>
</table>
</div>
<% } %>

<%- include('partials/footer') %>
